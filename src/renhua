SEV_ORDER = {"严重": 0, "警告": 1, "提示": 2}
SEV_TAG = {"严重": "🔴 严重", "警告": "🟠 警告", "提示": "⚪ 提示"}


def read_journal():
    try:
        return subprocess.run(["journalctl", "-xe", "--no-pager", "-n", "300"],
                              capture_output=True, text=True, timeout=30).stdout
    except Exception:
        return ""


def read_dmesg():
    try:
        r = subprocess.run(["dmesg", "-T"], capture_output=True, text=True, timeout=30)
        if r.returncode != 0:
            r = subprocess.run(["sudo", "-n", "dmesg", "-T"], capture_output=True, text=True, timeout=30)
        return r.stdout
    except Exception:
        return ""


def explain(text, top_only=False):
    samples = {}
    counts = {}
    for line in text.splitlines():
        s = line.strip()
        if not s:
            continue
        for regex, title, sev, human, advice, cat in RULES:
            if re.search(regex, s, re.IGNORECASE):
                counts[title] = counts.get(title, 0) + 1
                if title not in samples:
                    samples[title] = s[:220]
                break

    if not counts:
        print("没识别到已知的错误模式。你可以把报错原文直接贴给 renhua，或把它当普通日志看。")
        return

    info = {}
    for regex, title, sev, human, advice, cat in RULES:
        info[title] = (sev, human, advice)

    print("=" * 68)
    print("  报错翻译结果（共 %d 类 / %d 条命中）" % (len(counts), sum(counts.values())))
    print("=" * 68)
    items = sorted(counts.items(), key=lambda kv: (SEV_ORDER[info[kv[0]][0]], -kv[1]))
    for title, n in items:
        sev, human, advice = info[title]
        print("\n%s  %s   ×%d" % (SEV_TAG[sev], title, n))
        if not top_only:
            print("  原文 : %s" % samples[title])
            print("  人话 : %s" % human)
            print("  建议 : %s" % advice)
    if top_only:
        print("\n（--top 模式只显示统计；去掉该参数可看人话解释）")


def main():
    args = sys.argv[1:]
    if "--help" in args or "-h" in args:
        print(__doc__)
        return
    if "--rules" in args:
        print("内置规则 %d 条：\n" % len(RULES))
        for regex, title, sev, human, advice, cat in RULES:
            print("  [%s] %-28s %s" % (SEV_TAG[sev], title, regex[:60]))
        return
    top_only = "--top" in args
    text = ""
    if "--dmesg" in args:
        text = read_dmesg()
        if not text.strip():
            print("读不到内核日志（普通用户无权读取）。请改用：sudo dmesg -T | renhua  或  sudo renhua --dmesg")
            return
    elif "--journal" in args:
        text = read_journal()
        if not text.strip():
            print("读不到 journal。请改用：sudo journalctl -xe | renhua")
            return
    else:
        positional = [a for a in args if not a.startswith("--")]
        if positional:
            text = " ".join(positional)
        elif not sys.stdin.isatty():
            text = sys.stdin.read()
        else:
            text = read_dmesg()
    explain(text, top_only)


if __name__ == "__main__":
    main()
